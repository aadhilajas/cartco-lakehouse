# Docker Compose interpolation only. Local synthetic-data environment.
# The endpoint defaults inside containers are http://iceberg-rest:8181 and
# http://minio:9000. Host-side scripts accept ICEBERG_CATALOG_URI/S3_ENDPOINT.
AIRFLOW_UID=50000

# Application variables, if exported in the process running scripts:
# DATA_DIR=data
# SHOPIFY_CSV_PATH=data/raw/shopify_orders.csv
# AMAZON_CSV_PATH=data/raw/amazon_orders.csv
# ICEBERG_CATALOG_URI=http://localhost:8181
# S3_ENDPOINT=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=us-east-1
# OPENLINEAGE_URL=http://localhost:5000
# OPENLINEAGE_NAMESPACE=cartco-lakehouse
