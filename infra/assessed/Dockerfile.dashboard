FROM node:24.22.1-bookworm-slim@sha256:be8204d4bd327363357f532187b752ff62759c31bedf98e9e18fc08c9cbd605c AS build
WORKDIR /build
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY dashboard/index.html dashboard/vite.config.js ./
COPY dashboard/src ./src
RUN npm run build
FROM python:3.11.14-slim-bookworm@sha256:65a93d69fa75478d554f4ad27c85c1e69fa184956261b4301ebaf6dbb0a3543d
RUN useradd --create-home --uid 50000 cartco
COPY --from=build /build/dist /opt/cartco/dist
COPY scripts/runtime/serve_dashboard.py /opt/cartco/serve_dashboard.py
USER cartco
ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "/opt/cartco/serve_dashboard.py", "--dist", "/opt/cartco/dist", "--snapshot", "/data/assessed/public-snapshot.json", "--host", "0.0.0.0", "--port", "18100"]
