{
  "uid": "cartco-health",
  "title": "CartCo \u00b7 Airflow pipeline health",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "timezone": "utc",
  "tags": [
    "cartco",
    "assessed"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Started runs \u00b7 last 24h",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "cartco-airflow-health"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM cartco_monitoring.dag_health WHERE start_date >= now()-interval '24 hours'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No recorded run"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Failed runs \u00b7 last 24h",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "cartco-airflow-health"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM cartco_monitoring.dag_health WHERE state='failed' AND start_date >= now()-interval '24 hours'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No recorded run"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Latest successful completion",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "cartco-airflow-health"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT extract(epoch FROM max(end_date))*1000 AS value FROM cartco_monitoring.dag_health WHERE state='success'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "No recorded run"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Average duration \u00b7 last 24h",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "cartco-airflow-health"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT avg(extract(epoch FROM end_date-start_date)) AS value FROM cartco_monitoring.dag_health WHERE end_date IS NOT NULL AND start_date >= now()-interval '24 hours'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No recorded run"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Recent actual Airflow runs",
      "type": "table",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "cartco-airflow-health"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT dag_id,run_id,state,start_date,end_date,round(extract(epoch FROM end_date-start_date)::numeric,2) AS duration_seconds FROM cartco_monitoring.dag_health ORDER BY start_date DESC NULLS LAST LIMIT 50"
        }
      ]
    }
  ]
}
